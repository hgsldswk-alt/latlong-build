    "export.legacy": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"高度な機能が使えた期間に保存した地点を書き出せます。"}},"en":{"stringUnit":{"state":"translated","value":"Export points saved while advanced features were available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可继续导出高级功能开放期间保存的点位。"}}}},
    "export.fieldsTitle": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"書き出し項目"}},"en":{"stringUnit":{"state":"translated","value":"Export fields"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出字段"}}}},
    "export.fields": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"座標、名前、測位時刻、記録番号、水平精度、記録元。CSVにはプロジェクト、保存時刻、精度区分も含まれます。"}},"en":{"stringUnit":{"state":"translated","value":"Coordinates, name, fix time, sequence, horizontal accuracy and source. CSV also includes project, save time and quality."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"经纬度、名称、采样时间、序号、水平精度和来源。CSV 另含项目、保存时间和精度分级。"}}}},
    "export.csv": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"CSVを書き出す"}},"en":{"stringUnit":{"state":"translated","value":"Export CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 CSV"}}}},
    "export.gpx": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"GPXを書き出す"}},"en":{"stringUnit":{"state":"translated","value":"Export GPX"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 GPX"}}}},
    "export.kml": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"KMLを書き出す"}},"en":{"stringUnit":{"state":"translated","value":"Export KML"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 KML"}}}},
    "settings.title": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"設定"}},"en":{"stringUnit":{"state":"translated","value":"Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置"}}}},
    "help.locationTitle": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"測位のヒント"}},"en":{"stringUnit":{"state":"translated","value":"Location help"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"定位帮助"}}}},
    "help.location": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"端末が取得した位置は通信なしで記録できます。水平精度は端末が推定した誤差の目安です。必要に応じてシステム設定で「正確な位置情報」を許可してください。"}},"en":{"stringUnit":{"state":"translated","value":"You can save a fix your device has obtained without a data connection. Accuracy is the device’s estimated uncertainty radius. Enable Precise Location in system settings when needed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备取得的位置可以离线保存。水平精度是设备估计的不确定半径。需要时可在系统设置中开启精确位置。"}}}},
    "help.privacy": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録は端末内に保存されます。書き出し、共有カード、地点コードを使う前に、共有する内容をご確認ください。"}},"en":{"stringUnit":{"state":"translated","value":"Records stay on your device. Check what you’re disclosing before sharing files, cards or waypoint codes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录保存在设备本机。分享文件、卡片或地点口令前，请确认分享内容。"}}}},
    "trial.banner": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"最初の30日間はすべての機能を利用できます"}},"en":{"stringUnit":{"state":"translated","value":"All features are available for the first 30 days"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前 30 天可使用全部功能"}}}},
    "trial.until": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"無料期間の終了：%@"}},"en":{"stringUnit":{"state":"translated","value":"Trial ends: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"试用截至 %@"}}}},
    "trial.terms": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"無料期間は有料版の初回起動から30日間です。無料の試用証明は期間を延長しません。終了後は新規プロジェクトや新規地点の一括書き出しに買い切り購入が必要です。自動課金はありません。"}},"en":{"stringUnit":{"state":"translated","value":"The 30 days start when you first open the paid edition. Claiming a free receipt doesn’t extend them. New projects and batch export of new points then require a one-time purchase. No automatic charge."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"30 天从首次打开收费版开始，领取零元凭证不会延长试用。期满后，新建项目和批量导出新点位需要一次买断，无自动扣费。"}}}},
    "trial.ended": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"30日間の無料期間が終了しました"}},"en":{"stringUnit":{"state":"translated","value":"The 30-day trial has ended"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"30 天试用已结束"}}}},
    "trial.claim": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"無料の試用証明を取得"}},"en":{"stringUnit":{"state":"translated","value":"Claim free trial receipt"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"领取零元试用凭证"}}}},
    "trial.confirm": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"無料で取得"}},"en":{"stringUnit":{"state":"translated","value":"Claim for free"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免费领取"}}}},
    "trial.claimed": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"試用証明を取得済み"}},"en":{"stringUnit":{"state":"translated","value":"Trial receipt claimed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已领取试用凭证"}}}},
    "purchase.title": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"機能を購入"}},"en":{"stringUnit":{"state":"translated","value":"Unlock features"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"买断高级功能"}}}},

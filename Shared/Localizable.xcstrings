    "location.lowHelp": {"extractionState":"manual","localizations":{"ja":{"stringUnit":{"state":"translated","value":"空が開けた場所で測位を待つか、この精度のまま保存できます。"}},"en":{"stringUnit":{"state":"translated","value":"Wait for a better fix under open sky, or save with the current accuracy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可到开阔处等待更准确的读数，也可按当前精度保存。"}}}},
